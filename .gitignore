# ============================================================
# ExtraBite Monorepo .gitignore
# ============================================================

# Miscellaneous / OS
*.class
*.pyc
*.swp
.DS_Store
Thumbs.db
Desktop.ini
.history
.svn/
.atom/
.buildlog/
migrate_working_dir/

# Flutter / Dart
**/.dart_tool/
**/.packages
**/.pub/
**/.pub-cache/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/coverage/
**/doc/api/

# Android
**/.gradle/
**/local.properties
**/key.properties
**/*.jks
**/*.keystore
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

# iOS / macOS
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/.last_build_id
**/macos/Flutter/GeneratedPluginRegistrant.swift

# Web / Node
**/node_modules/

# Environment / local secret files (never commit)
.env
.env.*
*.env
!.env.example
**/.env
**/.env.*
**/*.env
!**/.env.example
ExtraBiteMobile/dart-defines.json

# IDE / Editor files
.idea/
.vscode/
**/.idea/
**/.vscode/
*.iml
**/*.iml
*.ipr
*.iws

# Local AI / Agent tooling state
.agents/
.claude/
agent/
skills-lock.json

# Logs & Temporary files
*.log
*.tmp
*.temp
app.*.symbols
app.*.map.json
